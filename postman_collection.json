{
	"info": {
		"_postman_id": "mindware-complete-api-coll",
		"name": "Mindware Job Portal - Complete API Collection",
		"description": "Comprehensive Postman collection for Mindware Job Portal. Includes all mobile-ready endpoints for Candidates and Employers.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"candidate@example.com\",\n  \"password\": \"password123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/login", "host": ["{{base_url}}"], "path": ["api", "v1", "login"] }
					}
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/forgot-password", "host": ["{{base_url}}"], "path": ["api", "v1", "forgot-password"] }
					}
				}
			]
		},
		{
			"name": "2. Public APIs",
			"item": [
				{
					"name": "Search Jobs",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/jobs?keyword=Software&location=Delhi",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "jobs"],
							"query": [ { "key": "keyword", "value": "Software" }, { "key": "location", "value": "Delhi" } ]
						}
					}
				},
				{
					"name": "Job Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{base_url}}/api/v1/jobs/cloud-devops-engineer", "host": ["{{base_url}}"], "path": ["api", "v1", "jobs", "cloud-devops-engineer"] }
					}
				}
			]
		},
		{
			"name": "3. Candidate Portal",
			"item": [
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [ { "key": "Authorization", "value": "Bearer {{jwt_token}}" } ],
						"url": { "raw": "{{base_url}}/api/v1/candidate/profile", "host": ["{{base_url}}"], "path": ["api", "v1", "candidate", "profile"] }
					}
				},
				{
					"name": "Apply for Job",
					"request": {
						"method": "POST",
						"header": [ { "key": "Authorization", "value": "Bearer {{jwt_token}}" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"resume_id\": 1,\n  \"cover_letter\": \"I am interested in this role.\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/candidate/jobs/1/apply", "host": ["{{base_url}}"], "path": ["api", "v1", "candidate", "jobs", "1", "apply"] }
					}
				},
				{
					"name": "Withdraw Application",
					"request": {
						"method": "POST",
						"header": [ { "key": "Authorization", "value": "Bearer {{jwt_token}}" } ],
						"url": { "raw": "{{base_url}}/api/v1/candidate/applications/1/withdraw", "host": ["{{base_url}}"], "path": ["api", "v1", "candidate", "applications", "1", "withdraw"] }
					}
				}
			]
		},
		{
			"name": "4. Employer Portal",
			"item": [
				{
					"name": "Post Job",
					"request": {
						"method": "POST",
						"header": [ { "key": "Authorization", "value": "Bearer {{jwt_token}}" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Senior React Developer\",\n  \"description\": \"Must have 5 years experience.\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/employer/jobs", "host": ["{{base_url}}"], "path": ["api", "v1", "employer", "jobs"] }
					}
				}
			]
		},
		{
			"name": "5. Payments & Subscription",
			"item": [
				{
					"name": "Initiate Payment",
					"request": {
						"method": "POST",
						"header": [ { "key": "Authorization", "value": "Bearer {{jwt_token}}" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"plan_id\": 2,\n  \"gateway\": \"razorpay\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/payments/initiate", "host": ["{{base_url}}"], "path": ["api", "v1", "payments", "initiate"] }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://192.168.1.24/MINDWAREINFOTECH" },
		{ "key": "jwt_token", "value": "YOUR_JWT_HERE" }
	]
}
