{
  "openapi": "3.0.0",
  "info": {
    "title": "Mindware Infotech Job Portal - Complete API",
    "description": "Comprehensive API documentation for Mindware Infotech Job Portal, supporting Mobile Apps (iOS/Android) and Web. Includes Authentication, Candidate & Employer Portals, Payments, Subscriptions, AI Job Matching, and Real-time Communications.",
    "version": "1.5.0"
  },
  "servers": [
    { "url": "http://192.168.1.24/MINDWAREINFOTECH", "description": "Local Network Server" },
    { "url": "https://mindwareinfotech.com", "description": "Production Server" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "type": "object" },
          "error": { "type": "string" }
        }
      }
    }
  },
  "security": [ { "bearerAuth": [] } ],
  "paths": {
    "/api/v1/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User Login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "email": { "type": "string" }, "password": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } } }
      }
    },
    "/api/v1/forgot-password": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Forgot Password",
        "security": [],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "email": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Link sent" } }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "tags": ["Public"],
        "summary": "List/Search Jobs",
        "security": [],
        "parameters": [
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "location", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/api/v1/jobs/{slug}": {
      "get": {
        "tags": ["Public"],
        "summary": "Get Job Details",
        "security": [],
        "parameters": [ { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/api/v1/candidate/jobs/{id}/apply": {
      "post": {
        "tags": ["Candidate - Jobs"],
        "summary": "Apply for a Job",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "resume_id": { "type": "integer" }, "cover_letter": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Applied" } }
      }
    },
    "/api/v1/candidate/applications/{id}/withdraw": {
      "post": {
        "tags": ["Candidate - Jobs"],
        "summary": "Withdraw Application",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "Withdrawn" } }
      }
    },
    "/api/v1/candidate/profile": {
      "get": { "tags": ["Candidate - Profile"], "summary": "Get Full Profile", "responses": { "200": { "description": "Success" } } },
      "put": { "tags": ["Candidate - Profile"], "summary": "Update Profile", "responses": { "200": { "description": "Updated" } } }
    },
    "/api/v1/candidate/profile/education": {
      "post": { "tags": ["Candidate - Profile"], "summary": "Add Education", "responses": { "201": { "description": "Added" } } }
    },
    "/api/v1/candidate/profile/experience": {
      "post": { "tags": ["Candidate - Profile"], "summary": "Add Experience", "responses": { "201": { "description": "Added" } } }
    },
    "/api/v1/candidate/resumes": {
      "get": { "tags": ["Candidate - Profile"], "summary": "List Resumes", "responses": { "200": { "description": "Success" } } },
      "post": { "tags": ["Candidate - Profile"], "summary": "Upload Resume", "responses": { "201": { "description": "Uploaded" } } }
    },
    "/api/v1/candidate/alerts": {
      "get": { "tags": ["Candidate - Jobs"], "summary": "List Job Alerts", "responses": { "200": { "description": "Success" } } },
      "post": { "tags": ["Candidate - Jobs"], "summary": "Create Job Alert", "responses": { "201": { "description": "Created" } } }
    },
    "/api/v1/payments/initiate": {
      "post": {
        "tags": ["Payments & Subscriptions"],
        "summary": "Initiate Payment",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "plan_id": { "type": "integer" }, "gateway": { "type": "string", "example": "razorpay" } } } } } },
        "responses": { "200": { "description": "Payment initialized" } }
      }
    },
    "/api/v1/payments/verify": {
      "post": {
        "tags": ["Payments & Subscriptions"],
        "summary": "Verify Payment Status",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "order_id": { "type": "string" }, "payment_id": { "type": "string" }, "signature": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Verified" } }
      }
    },
    "/api/v1/subscription/current": {
      "get": { "tags": ["Payments & Subscriptions"], "summary": "Get Current Active Plan", "responses": { "200": { "description": "Success" } } }
    },
    "/api/v1/employer/jobs": {
      "get": { "tags": ["Employer - Jobs"], "summary": "List My Jobs", "responses": { "200": { "description": "Success" } } },
      "post": { "tags": ["Employer - Jobs"], "summary": "Post New Job", "responses": { "201": { "description": "Created" } } }
    },
    "/api/v1/employer/applications": {
      "get": { "tags": ["Employer - Candidates"], "summary": "View Applications Received", "responses": { "200": { "description": "Success" } } }
    },
    "/api/v1/employer/applications/{id}/shortlist": {
      "post": { "tags": ["Employer - Candidates"], "summary": "Shortlist Candidate", "responses": { "200": { "description": "Success" } } }
    },
    "/api/v1/conversations": {
      "get": { "tags": ["Communication"], "summary": "List Chat Conversations", "responses": { "200": { "description": "Success" } } },
      "post": { "tags": ["Communication"], "summary": "Start Conversation", "responses": { "201": { "description": "Started" } } }
    },
    "/api/v1/conversations/{id}/messages": {
      "get": { "tags": ["Communication"], "summary": "Get Messages", "responses": { "200": { "description": "Success" } } },
      "post": { "tags": ["Communication"], "summary": "Send Message", "responses": { "201": { "description": "Sent" } } }
    },
    "/api/v1/notifications": {
      "get": { "tags": ["Communication"], "summary": "List Notifications", "responses": { "200": { "description": "Success" } } }
    },
    "/api/countries": { "get": { "tags": ["Geo"], "summary": "List Countries", "responses": { "200": { "description": "Success" } } } },
    "/api/states": { "get": { "tags": ["Geo"], "summary": "List States", "parameters": [{ "name": "country", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Success" } } } },
    "/api/cities": { "get": { "tags": ["Geo"], "summary": "List Cities", "parameters": [{ "name": "state", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Success" } } } }
  }
}
