Options -Indexes
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Allow static assets/directories to be served directly
RewriteCond %{REQUEST_URI} ^/(uploads|assets|css|js|images|public)/ [NC]
RewriteRule ^ - [L]

# If file exists, serve directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Otherwise send to index.php
RewriteRule ^ index.php [L]
